# Copy this file to .env and fill it in. Never commit .env.

# Discord: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Your own Discord user ID (Settings -> Advanced -> Developer Mode, then long-press your name -> Copy User ID)
DISCORD_OWNER_ID=
# Optional but recommended: your server's ID, so commands show up instantly
DISCORD_GUILD_ID=

# Alpaca: app.alpaca.markets -> API Keys (use your PAPER account's keys to start)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Leave true until you've tested everything. Set to false for real money.
ALPACA_PAPER=true

# Refuse any single buy/sell bigger than this many dollars
MAX_ORDER_VALUE=1000
# How often to check for filled orders, in seconds
FILL_POLL_SECONDS=30
